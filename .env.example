# Copy this file to .env and fill in real values. Never commit .env.

# LinkedIn Developer app credentials (from https://www.linkedin.com/developers/apps)
LINKEDIN_CLIENT_ID=your_client_id
LINKEDIN_CLIENT_SECRET=your_client_secret

# Must exactly match a redirect URL registered on the app's Auth tab.
LINKEDIN_REDIRECT_URI=http://localhost:8000/callback

# LinkedIn versions the API by month. Bump this to a recent YYYYMM when the
# current value stops being accepted. See the API changelog for supported values.
LINKEDIN_API_VERSION=202607

# Anthropic API key for drafting the post copy.
ANTHROPIC_API_KEY=your_anthropic_key

# Model used to draft posts.
ANTHROPIC_MODEL=claude-sonnet-5

# Stage B: number of post ideas to brainstorm (default 3).
BRAINSTORM_IDEA_COUNT=3

# GitHub, for the AI agent log (Stage A). Read-only fine-grained PAT (Contents: Read).
# Public repos work without a token; private repos need one.
GITHUB_TOKEN=your_readonly_github_pat

# Repos the agent log should track, comma-separated "owner/repo".
GITHUB_REPOS=iviang/linkedin-blogger

# Stage C: minutes before scheduled publish when edits lock (default 15).
QUEUE_LOCK_MINUTES=15

# Stage C: weekly email nudge (Gmail example uses an app password, not your login).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your_gmail_app_password
NUDGE_FROM=you@gmail.com
NUDGE_TO=you@gmail.com
